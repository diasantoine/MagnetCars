# =========================
# Unreal Engine Git Ignore
# =========================

# Ignore project user-specific files
*.suo
*.user
*.userprefs
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.cache
*.log
*.tlog
*.ipch
*.pdb
*.obj
*.idb
*.res
*.ilk
*.exp

# Ignore Unreal autogenerated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb

# Ignore local project build results
*.xcodeproj
*.xcworkspace
*.xcuserstate
*.xcuserdata/
*.sln
*.suo
*.opensdf
*.sdf

# Ignore OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Ignore Unreal Build Tool generated files
*.target
*.modules
*.manifest
*.json
*.csproj
*.targets
*.pri
*.filters
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Ignore crash and log files
*.dmp
*.log
*.log.tmp

# Ignore configuration backups
*.ini~
*.bak

# Ignore Unreal autosaves and backups
Saved/Autosaves/
Saved/Backup/
Saved/StagedBuilds/
Saved/Logs/
Saved/Collections/

# Ignore temporary plugin build data
Plugins/*/Intermediate/
Plugins/*/Binaries/
Plugins/*/DerivedDataCache/

# =========================
# FMOD
# =========================
# Ignore FMOD build caches and generated banks
FMOD/Desktop/
FMOD/Mobile/
FMOD/Build/
FMOD/Cache/
FMOD/.cache/
FMOD/.bankcache/
FMOD/.cachefilelist
FMOD/.log
FMOD/Temp/
FMOD/.DS_Store

# Keep only FMOD Studio project files and metadata
!FMOD/*.fspro
!FMOD/.fspro
!FMOD/Metadata/
!FMOD/Assets/
!FMOD/Plugins/
!FMOD/Scripts/

# =========================
# Unreal Project Files
# =========================
# Keep essential source and config files
!Source/
!Config/
!Content/
!Plugins/
!FMOD/
!*.uproject
!*.uplugin
!README.md
!LICENSE